{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Avvia CodeSpace in locale",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-Command",
        "Get-Process CodeSpace -ErrorAction SilentlyContinue | Stop-Process -Force; Get-Process node -ErrorAction SilentlyContinue | Stop-Process -Force; npx tauri dev"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "codeSpace": {
        "taskType": "live-server",
        "url": "http://localhost:1420",
        "confirmationRequest": true
      }
    },
    {
      "label": "Test echo",
      "type": "shell",
      "command": "echo",
      "args": ["Task eseguita correttamente da CodeSpace!"],
      "codeSpace": {
        "taskType": "test",
        "confirmationRequest": true
      }
    },
    {
      "label": "Live Server Test",
      "type": "shell",
      "command": "ping",
      "args": ["-t", "localhost"],
      "codeSpace": {
        "taskType": "live-server"
      }
    }
  ]
}
