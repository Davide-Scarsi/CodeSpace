{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Avvia CodeSpace in locale",
      "type": "shell",
      "command": "npx tauri dev",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "codeSpace": {
        "taskType": "live-server"
      }
    },
    {
      "label": "🧪 Test echo",
      "type": "shell",
      "command": "echo",
      "args": ["Task eseguita correttamente da CodeSpace!"],
      "codeSpace": {
        "taskType": ""
      }
    },
    {
      "label": "🧪 Live Server Test",
      "type": "shell",
      "command": "ping",
      "args": ["-t", "localhost"],
      "codeSpace": {
        "taskType": "live-server"
      }
    }
  ]
}
